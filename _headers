# Keep HTML and client assets fresh after deployments so browsers/CDNs do not reuse an older menu renderer.
/
  Cache-Control: no-store, no-cache, must-revalidate
  CDN-Cache-Control: no-store

/*.html
  Cache-Control: no-store, no-cache, must-revalidate
  CDN-Cache-Control: no-store

/*.js
  Cache-Control: no-store, no-cache, must-revalidate
  CDN-Cache-Control: no-store

/*.css
  Cache-Control: no-store, no-cache, must-revalidate
  CDN-Cache-Control: no-store
